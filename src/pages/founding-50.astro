---
import PremiumLayout from "../layouts/premium.astro";
---

<PremiumLayout title="Naviget - Premium Airport and Rental Rides">
    <section class="bg-black text-white">
        <div class="mx-auto grid grid-cols-1 md:grid-cols-2 sm:min-h-screen items-center max-w-7xl md:gap-5">
            <div class="p-5 max-w-xl mx-auto">
                <h1 class="text-6xl mb-4">Naviget Select for Selected Rides</h1>
                <p class="mb-2 sm:mb-12 text-xl">
                    A private concierge for airport transfers and hourly rides,
                    built around reliability, comfort and personal service.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a
                        type="button"
                        class="flex-1 hover:cursor-pointer uppercase text-black bg-white rounded-full p-4 text-center"
                        href="https://wa.me/+917481832657"
                        target="_blank"
                    >
                        WhatsApp Concierge
                    </a>
                    <a
                        type="button"
                        class="flex-1 hover:cursor-pointer uppercase border rounded-full p-4 text-center app-download"
                    >
                        Download App
                    </a>
                </div>
            </div>
            <div class="p-5 max-w-xl mx-auto">
                <img
                    class="rounded-3xl"
                    src="/images/founding_50_landing.png"
                    alt="Naviget Founding 50. Select Premium Rides."
                />
            </div>
        </div>
    </section>
    <section class="bg-black text-white px-5">
        <div class="max-w-7xl mx-auto">
            <h2 class="text-4xl md:text-6xl mb-4 md:mb-8 text-center pt-5">
                Reliability First
            </h2>
            <p class="text-xl md:text-2xl max-w-xl md:max-w-none mb-12 mx-auto">
                We believe every journey should be dependable, comfortable, and
                stress-free. With punctual pickups, well-maintained cabs, and
                trusted chauffeurs, we’re committed to getting you where you
                need to be safely and on time.
            </p>
            <div class="flex flex-col md:flex-row items-center md:gap-5">
                <div class="max-w-xl md:mr-auto">
                    <img
                        class="rounded-3xl object-cover aspect-square"
                        src="/images/founding_50_confirmed_pickup.png"
                        alt="Naviget Founding 50. Confirmed Pickups."
                    />
                </div>
                <div class="max-w-xl mt-2">
                    <h3 class="text-3xl md:text-5xl mb-4">Confirmed Pickups</h3>
                    <p class="mb-2 sm:mb-12 sm:text-xl">
                        Backed by our 0-cancellation promise, so your car shows
                        up when it’s supposed to.
                    </p>
                </div>
            </div>
            <div class="flex flex-col-reverse md:flex-row items-center md:gap-5 mt-8">
                <div class="max-w-xl">
                    <h3 class="text-3xl md:text-5xl mb-4 mt-2">
                        Professional Chauffeurs
                    </h3>
                    <p class="mb-2 sm:mb-12 sm:text-xl">
                        Trained, verified chauffeurs focused on safe driving,
                        good etiquette and a smooth ride.
                    </p>
                </div>
                <div class="max-w-xl md:ml-auto">
                    <img
                        class="rounded-3xl object-cover aspect-square"
                        src="/images/founding_50_professional_chauffeurs.png"
                        alt="Naviget Founding 50. Professional Chauffeurs."
                    />
                </div>
            </div>
        </div>
    </section>

    <section class="bg-black text-white pt-20 px-5 flex justify-center">
        <div class="max-w-7xl">
            <p class="uppercase text-xl">Who is this for?</p>
            <h2 class="text-4xl md:text-6xl mb-4 md:mb-8 pt-5">
                Built for the 2% who value <br /> Reliability
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 md:gap-5">
                <div class="max-w-xl">
                    <img
                        class="rounded-3xl aspect-square object-cover"
                        src="/images/founding_50_placard_pickup.png"
                        alt="Naviget Founding 50. Pla-card Pickups."
                    />
                    <div class="p-5 max-w-xl mx-auto">
                        <h3 class="text-3xl mb-4 text-center">
                            Pla-card Pickups
                        </h3>
                    </div>
                </div>

                <div class="max-w-xl">
                    <img
                        class="rounded-3xl aspect-square object-cover"
                        src="/images/founding_50_incabin_essential.png"
                        alt="Naviget Founding 50. In cabin essentials."
                    />
                    <div class="p-5 max-w-xl">
                        <h3 class="text-3xl mb-4 text-center">
                            In Cabin Essentials
                        </h3>
                    </div>
                </div>

                <div class="max-w-xl">
                    <img
                        class="rounded-3xl aspect-square object-cover"
                        src="/images/founding_50_captain_seats.png"
                        alt="Naviget Founding 50. Captain Seats."
                    />
                    <div class="p-5 max-w-xl">
                        <h3 class="text-3xl mb-4 text-center">Captain Seats</h3>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-black text-white px-5 py-20">
        <div class="max-w-7xl mx-auto">
            <div class="flex flex-col-reverse md:flex-row items-center md:gap-5 py-10">
                <div class="max-w-xl mt-2">
                    <h3 class="text-3xl md:text-5xl mb-4">
                        Safety never takes a backseat
                    </h3>
                    <p class="mb-2 sm:mb-12 sm:text-xl">
                        Every ride is built around safety, verified chauffeurs,
                        monitored driving, and human support whenever you need
                        it.
                    </p>
                </div>
                <div class="max-w-xl md:max-w-2xl md:ml-auto">
                    <img
                        class="rounded-3xl object-cover aspect-2"
                        src="/images/founding_50_safety.png"
                        alt="Naviget Founding 50. Safety."
                    />
                </div>
            </div>
            <div class="flex flex-col md:flex-row items-center md:gap-5 mt-8 py-10">
                <div class="max-w-xl md:max-w-2xl md:mr-auto">
                    <img
                        class="rounded-3xl object-cover"
                        src="/images/founding_50_accessible.png"
                        alt="Naviget Founding 50. Making rides more
                        accessible."
                    />
                </div>
                <div class="max-w-xl">
                    <h3 class="text-3xl md:text-5xl mb-4 mt-2">
                        Making rides more accessible
                    </h3>
                    <p class="mb-2 sm:mb-12 sm:text-xl">
                        Extra assistance when needed, <br /> from helping
                        elderly guests to accommodating wheelchairs and mobility
                        needs.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-black text-white py-20 px-5">
        <div class="max-w-7xl mx-auto">
            <div class="flex flex-col md:flex-row md:gap-5 items-center">
                <div class="flex-1">
                    <div class="max-w-xl mx-auto">
                        <img
                            class="rounded-3xl object-cover"
                            src="/images/founding_50_airport_transfer.png"
                            alt="Naviget Founding 50. Airport Transfer."
                        />
                        <div class="py-5">
                            <h3 class="text-3xl mb-4">Airport transfers</h3>
                            <p>
                                Pre-booked airport rides with flight tracking,
                                confirmed pickups, and a smooth door-to-terminal
                                experience.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="flex-1">
                    <div class="max-w-xl mx-auto">
                        <img
                            class="rounded-3xl object-cover"
                            src="/images/founding_50_rentals.png"
                            alt="Naviget Founding 50. Hourly Rentals."
                        />
                        <div class="py-5">
                            <h3 class="text-3xl mb-4">Hourly Rentals</h3>
                            <p>
                                Keep the car and chauffeur with you for
                                meetings, errands or a full day across the city.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-black text-white py-20 px-5">
        <div class="max-w-xl md:max-w-7xl mx-auto">
            <img
                class="w-full rounded-3xl object-cover"
                src="/images/founding_50_cta.png"
                alt="Naviget Founding 50. Call To Action."
            />
            <div class="flex flex-col md:flex-row md:gap-5 justify-between py-5">
                <div class="max-w-xl flex-1">
                    <h3 class="text-3xl mb-4">1. Request</h3>
                    <p class="text-lg">
                        Request a ride through the app or whatsapp concierge
                    </p>
                </div>
                <div class="max-w-xl flex-1">
                    <h3 class="text-3xl mb-4">2. Ride</h3>
                    <p class="text-lg">
                        Enjoy your ride with curated experience
                    </p>
                </div>
                <div class="max-w-xl flex-1">
                    <h3 class="text-3xl mb-4">3. Arrive</h3>
                    <p class="text-lg">
                        Reach comfortably, safely and on time. And share your
                        feedback
                    </p>
                </div>
            </div>
        </div>
    </section>
</PremiumLayout>
